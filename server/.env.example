# MongoDB Atlas Connection String
# Replace <username>, <password>, and <dbname> with your actual values
MONGO_URI=PASTE_YOUR_ATLAS_URI_HERE
# MONGODB_URI is also supported for existing deployments.

# Strong random secret for signing JWTs
JWT_SECRET=cms_jwt_super_secret_key_2024_do_not_share

# Port on which the server will run
PORT=5000

# Environment (development / production)
NODE_ENV=development
